{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"]
  },
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=assistant_db;Username=assistant;Password=change_this_password_in_production"
  },
  "Ollama": {
    "BaseUrl": "http://ollama:11434"
  },
  "Qdrant": {
    "Host": "qdrant",
    "Port": "6334"
  },
  "Assistant": {
    "ChatModel": "qwen2.5-coder:7b",
    "EmbeddingModel": "nomic-embed-text",
    "ChunkSize": 512,
    "ChunkOverlap": 64,
    "TopK": 3,
    "InstructionTopK": 1,
    "Temperature": 0.2
  },
  "Jwt": {
    "Secret": "my_secret_32_char_secret_minimum",
    "Issuer": "ai-coding-assistant",
    "Audience": "ai-coding-assistant-clients"
  },
  "Ingestion": {
    "RepositoryCachePath": "/data/repository-cache",
    "UploadPath": "/data/uploads"
  },
  "AllowedHosts": "*"
}
